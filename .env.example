# --- vCenter (collector only) ---
# vCenter hostname or IP, optionally with :port (IPv6 with a port: [2001:db8::5]:443)
VCENTER_HOST=vcsa01.example.local
# Service account; a read-only vCenter role is enough
VCENTER_USER=svc-vmdash@vsphere.local
VCENTER_PASSWORD=change-me
# Set to false only for self-signed certificates you cannot trust
VCENTER_VERIFY_SSL=true
# PEM file with the CA that signed the vCenter certificate (vCenter's own VMCA: the .crt files from
# https://<vcenter>/certs/download.zip); empty = the system trust store
VCENTER_CA_FILE=
# Limit to one datacenter by name; empty = all datacenters
VCENTER_DATACENTER=
# Minutes between syncs
SYNC_INTERVAL_MINUTES=15

# --- Shared ---
# SQLite file (both processes); --db on the command line overrides it.
# Production: /var/lib/vmdash/vmdash.db (see examples/vmdash.env); the services cannot write elsewhere.
SQLITE_PATH=./vmdash.db
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Optional log file (rotated 10 MB x 5); empty = stdout only (journald under systemd)
LOG_FILE=

# --- Web (web only) ---
# Listen address and port; 127.0.0.1 when a reverse proxy runs on the same machine
WEB_HOST=0.0.0.0
WEB_PORT=8080
# HTTP basic auth credentials (required)
WEB_USER=admin
WEB_PASSWORD=change-me
# Optional TLS: basic auth over plain HTTP exposes the password on the network
WEB_SSL_CERT=
WEB_SSL_KEY=
