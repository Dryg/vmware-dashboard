# /etc/vmdash/vmdash.env: production settings for both services (owner vmdash, mode 600).
# Every setting is described in .env.example at the repository root.

# --- vCenter (collector) ---
VCENTER_HOST=vcsa01.example.local
VCENTER_USER=svc-vmdash@vsphere.local
VCENTER_PASSWORD=change-me
VCENTER_VERIFY_SSL=true
# CA of the vCenter certificate if it is not in the system trust store, e.g. /etc/vmdash/vcenter-ca.pem
VCENTER_CA_FILE=
VCENTER_DATACENTER=
SYNC_INTERVAL_MINUTES=15

# --- Shared ---
SQLITE_PATH=/var/lib/vmdash/vmdash.db
LOG_LEVEL=INFO
# empty = journald (journalctl -u vmdash-collector -u vmdash-web)
LOG_FILE=

# --- Web ---
# Only nginx on this machine talks to the app; TLS ends at nginx (examples/nginx/).
WEB_HOST=127.0.0.1
WEB_PORT=8080
# vSphere Client link in the header; empty = https://VCENTER_HOST/ui/
VCENTER_UI_URL=
WEB_USER=admin
WEB_PASSWORD=change-me
WEB_SSL_CERT=
WEB_SSL_KEY=
